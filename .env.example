# Offline, deterministic behavior is enabled unless explicitly set to false.
MOCK_MODE=true

# Optional Firebase web configuration; the starter UI works without it.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
VITE_FIREBASE_VAPID_KEY=
VITE_USE_FIREBASE_EMULATORS=false
VITE_MOCK_MODE=true

# Groq multimodal LLM & Vision for prescription digitization & label verification
VITE_GROQ_API_KEY=
GROQ_API_KEY=

# Server-only local speech proxy (put the real key in ignored .env.local).
SARVAM_API_KEY=

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  function signedIn() {
    return request.auth != null && request.auth.token.email_verified == true;
  }

  function memberPath(profileId) {
    return /databases/$(database)/documents/profiles/$(profileId)/members/$(request.auth.uid);
  }

  function isMember(profileId) {
    return signedIn() && exists(memberPath(profileId));
  }

  function role(profileId) {
    return get(memberPath(profileId)).data.role;
  }

  function personalCreator(profileId) {
    let profile = getAfter(/databases/$(database)/documents/profiles/$(profileId)).data;
    return signedIn() && profile.ownerUid == request.auth.uid && profile.accessMode == 'personal';
  }
  function canManageMedication(profileId) {
    return isMember(profileId) && role(profileId) in ['elder', 'caretaker', 'doctor'];
  }

  function canLogDose(profileId) { return isMember(profileId) && role(profileId) in ['elder', 'caretaker']; }
  function isOwner(profileId) {
    let profile = get(/databases/$(database)/documents/profiles/$(profileId)).data;
    return isMember(profileId) && profile.get('ownerUid', profile.createdBy) == request.auth.uid;
  }
  function validAppointment(profileId) {
    let data = request.resource.data;
    let doctor = data.get('doctorUid', null);
    return data.keys().hasOnly(['doctorName', 'doctorUid', 'specialty', 'dateTime', 'location', 'notes', 'createdBy', 'remindersSent'])
      && data.doctorName is string && data.doctorName.size() > 0 && data.doctorName.size() <= 120
      && data.specialty is string && data.specialty.size() <= 120 && data.dateTime is timestamp
      && data.location is string && data.location.size() <= 300 && data.notes is string && data.notes.size() <= 1000
      && (doctor == null || (doctor is string && get(/databases/$(database)/documents/profiles/$(profileId)/members/$(doctor)).data.role == 'doctor'));
  }

  function validMedication() {
    return request.resource.data.keys().hasAll([
        'name', 'dosage', 'times', 'frequency', 'startDate', 'endDate', 'notes',
        'active', 'updatedBy', 'updatedAt'
      ])
      && request.resource.data.keys().hasOnly([
        'name', 'dosage', 'times', 'frequency', 'startDate', 'endDate', 'notes',
        'active', 'imageUrl', 'updatedBy', 'updatedAt'
      ])
      && (!('imageUrl' in request.resource.data) || (request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 2048 && (request.resource.data.imageUrl == '' || request.resource.data.imageUrl.matches('^https://.*'))))
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 120
      && request.resource.data.dosage is string
      && request.resource.data.dosage.size() > 0
      && request.resource.data.dosage.size() <= 80
      && request.resource.data.times is list
      && request.resource.data.times.size() > 0
      && request.resource.data.times.size() <= 12
      && request.resource.data.frequency is map
      && request.resource.data.frequency.type in ['daily', 'weekdays', 'interval']
      && (request.resource.data.frequency.type == 'daily'
        ? request.resource.data.frequency.keys().hasOnly(['type'])
        : request.resource.data.frequency.type == 'weekdays'
          ? request.resource.data.frequency.keys().hasOnly(['type', 'days'])
            && (!('days' in request.resource.data.frequency)
              || (request.resource.data.frequency.days is list
                && request.resource.data.frequency.days.size() > 0
                && request.resource.data.frequency.days.size() <= 7
                && request.resource.data.frequency.days.hasOnly([0, 1, 2, 3, 4, 5, 6])))
          : request.resource.data.frequency.keys().hasOnly(['type', 'everyNDays'])
            && request.resource.data.frequency.everyNDays is int
            && request.resource.data.frequency.everyNDays >= 1
            && request.resource.data.frequency.everyNDays <= 365)
      && request.resource.data.startDate is string
      && request.resource.data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && (request.resource.data.endDate == null
        || (request.resource.data.endDate is string
          && request.resource.data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
      && request.resource.data.notes is string
      && request.resource.data.notes.size() <= 500
      && request.resource.data.active is bool
      && request.resource.data.updatedBy == request.auth.uid
      && request.resource.data.updatedAt is timestamp;
  }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, delete: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','email','displayName'])
        && request.resource.data.uid == uid && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100;
    }
    match /users/{uid}/profiles/{profileId} {
      allow get, list: if signedIn() && request.auth.uid == uid;
      allow create: if request.auth.uid == uid && personalCreator(profileId)
        && request.resource.data.profileId == profileId
        && request.resource.data.ownerUid == uid;
      allow update, delete: if false;
    }

    match /profiles/{profileId} {
      allow get, list: if isMember(profileId);
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['elderName','timezone','relationship','ownerUid','createdBy','elderUid','graceMinutes','accessMode'])
        && request.resource.data.ownerUid == request.auth.uid && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.accessMode == 'personal' && request.resource.data.graceMinutes == 30
        && request.resource.data.relationship in ['self','parent','relative','other']
        && request.resource.data.elderName is string && request.resource.data.elderName.size() > 0 && request.resource.data.elderName.size() <= 100
        && request.resource.data.timezone is string && request.resource.data.timezone.size() <= 64
        && request.resource.data.elderUid == (request.resource.data.relationship == 'self' ? request.auth.uid : null);
      allow update, delete: if false;

      match /members/{uid} {
        allow read: if isMember(profileId);
        allow create: if request.auth.uid == uid && personalCreator(profileId)
          && request.resource.data.keys().hasOnly(['uid','role','email','displayName','joinedAt'])
          && request.resource.data.uid == uid && request.resource.data.email == request.auth.token.email
          && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100
          && request.resource.data.joinedAt is timestamp
          && request.resource.data.role == (getAfter(/databases/$(database)/documents/profiles/$(profileId)).data.relationship == 'self' ? 'elder' : 'caretaker');
        allow update, delete: if false;

        match /private/{privateDocument}/pushTokens/{tokenId} {
          allow read: if false;
          allow create, update: if isMember(profileId) && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
            && request.resource.data.token is string
            && request.resource.data.updatedAt is timestamp;
          allow delete: if isMember(profileId) && request.auth.uid == uid;
        }
      }

      match /private/{document=**} {
        allow read, write: if false;
      }

      match /medications/{medicationId} {
        allow read: if isMember(profileId);
        allow create, update: if canManageMedication(profileId) && validMedication();
        allow delete: if canManageMedication(profileId);
      }

      match /doseLogs/{doseLogId} {
        allow read: if isMember(profileId);
        allow create: if canLogDose(profileId) && personalCreator(profileId)
          && request.resource.data.keys().hasOnly(['medicationId','scheduledFor','status','loggedBy','loggedAt'])
          && request.resource.data.medicationId is string
          && exists(/databases/$(database)/documents/profiles/$(profileId)/medications/$(request.resource.data.medicationId))
          && request.resource.data.scheduledFor is timestamp
          && request.resource.data.status in ['taken','skipped']
          && request.resource.data.loggedBy == request.auth.uid && request.resource.data.loggedAt is timestamp;
        allow delete: if false;
        allow update: if canLogDose(profileId)
          && resource.data.status in ['pending', 'missed']
          && request.resource.data.status in ['taken', 'skipped']
          && request.resource.data.loggedBy == request.auth.uid
          && request.resource.data.loggedAt is timestamp
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'loggedBy', 'loggedAt']);
      }

      match /appointments/{appointmentId} {
        allow read: if isMember(profileId);
        allow create: if canManageMedication(profileId) && validAppointment(profileId)
          && !('remindersSent' in request.resource.data) && request.resource.data.createdBy == request.auth.uid;
        allow update: if canManageMedication(profileId) && validAppointment(profileId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doctorName', 'doctorUid', 'specialty', 'dateTime', 'location', 'notes']);
        allow delete: if canManageMedication(profileId);
      }
      match /invitations/{id} { allow read: if isOwner(profileId); allow write: if false; }
      match /auditEvents/{id} { allow read: if isOwner(profileId); allow write: if false; }
      match /alertDeliveries/{id} { allow read: if isMember(profileId); allow write: if false; }
      match /notificationSettings/{id} {
        allow read: if isMember(profileId) && role(profileId) == 'caretaker';
        allow create, update: if id == 'escalation' && isMember(profileId) && role(profileId) == 'caretaker'
          && request.resource.data.keys().hasOnly(['enabled','email','smsNumber','consentConfirmed','updatedBy','updatedAt'])
          && request.resource.data.enabled is bool && request.resource.data.consentConfirmed is bool
          && request.resource.data.email is string && request.resource.data.email.size() <= 254
          && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
          && request.resource.data.smsNumber == ''
          && (!request.resource.data.enabled || request.resource.data.consentConfirmed)
          && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt is timestamp;
      }

      match /reminders/{reminderId} {
        allow read: if isMember(profileId);
        allow write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}


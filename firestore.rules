rules_version = '2';
service cloud.firestore {
  function signedIn() {
    return request.auth != null;
  }

  function memberPath(profileId) {
    return /databases/$(database)/documents/profiles/$(profileId)/members/$(request.auth.uid);
  }

  function isMember(profileId) {
    return signedIn() && exists(memberPath(profileId));
  }

  function role(profileId) {
    return get(memberPath(profileId)).data.role;
  }

  function canManageMedication(profileId) {
    return isMember(profileId) && role(profileId) in ['elder', 'caretaker'];
  }

  function validMedication() {
    return request.resource.data.keys().hasAll([
        'name', 'dosage', 'times', 'frequency', 'startDate', 'endDate', 'notes',
        'active', 'updatedBy', 'updatedAt'
      ])
      && request.resource.data.keys().hasOnly([
        'name', 'dosage', 'times', 'frequency', 'startDate', 'endDate', 'notes',
        'active', 'updatedBy', 'updatedAt'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 120
      && request.resource.data.dosage is string
      && request.resource.data.dosage.size() > 0
      && request.resource.data.dosage.size() <= 80
      && request.resource.data.times is list
      && request.resource.data.times.size() > 0
      && request.resource.data.times.size() <= 12
      && request.resource.data.frequency is map
      && request.resource.data.frequency.type in ['daily', 'weekdays', 'interval']
      && (request.resource.data.frequency.type == 'daily'
        ? request.resource.data.frequency.keys().hasOnly(['type'])
        : request.resource.data.frequency.type == 'weekdays'
          ? request.resource.data.frequency.keys().hasOnly(['type', 'days'])
            && (!('days' in request.resource.data.frequency)
              || (request.resource.data.frequency.days is list
                && request.resource.data.frequency.days.size() > 0
                && request.resource.data.frequency.days.size() <= 7
                && request.resource.data.frequency.days.hasOnly([0, 1, 2, 3, 4, 5, 6])))
          : request.resource.data.frequency.keys().hasOnly(['type', 'everyNDays'])
            && request.resource.data.frequency.everyNDays is int
            && request.resource.data.frequency.everyNDays >= 1
            && request.resource.data.frequency.everyNDays <= 365)
      && request.resource.data.startDate is string
      && request.resource.data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
      && (request.resource.data.endDate == null
        || (request.resource.data.endDate is string
          && request.resource.data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
      && request.resource.data.notes is string
      && request.resource.data.notes.size() <= 500
      && request.resource.data.active is bool
      && request.resource.data.updatedBy == request.auth.uid
      && request.resource.data.updatedAt is timestamp;
  }

  match /databases/{database}/documents {
    match /users/{uid}/profiles/{profileId} {
      allow get, list: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /profiles/{profileId} {
      allow get, list: if isMember(profileId);
      allow create, update, delete: if false;

      match /members/{uid} {
        allow read: if isMember(profileId);
        allow write: if false;

        match /private/{privateDocument}/pushTokens/{tokenId} {
          allow read: if false;
          allow create, update: if signedIn() && request.auth.uid == uid
            && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
            && request.resource.data.token is string
            && request.resource.data.updatedAt is timestamp;
          allow delete: if signedIn() && request.auth.uid == uid;
        }
      }

      match /private/{document=**} {
        allow read, write: if false;
      }

      match /medications/{medicationId} {
        allow read: if isMember(profileId);
        allow create, update: if canManageMedication(profileId) && validMedication();
        allow delete: if canManageMedication(profileId);
      }

      match /doseLogs/{doseLogId} {
        allow read: if isMember(profileId);
        allow create, delete: if false;
        allow update: if canManageMedication(profileId)
          && resource.data.status == 'pending'
          && request.resource.data.status in ['taken', 'skipped']
          && request.resource.data.loggedBy == request.auth.uid
          && request.resource.data.loggedAt is timestamp
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'loggedBy', 'loggedAt']);
      }

      match /appointments/{appointmentId} {
        allow read: if isMember(profileId);
        allow create: if isMember(profileId)
          && request.resource.data.keys().hasOnly(['doctorName', 'specialty', 'dateTime', 'location', 'notes', 'createdBy'])
          && request.resource.data.doctorName is string
          && request.resource.data.doctorName.size() > 0
          && request.resource.data.doctorName.size() <= 120
          && request.resource.data.specialty is string
          && request.resource.data.specialty.size() <= 120
          && request.resource.data.dateTime is timestamp
          && request.resource.data.location is string
          && request.resource.data.location.size() <= 300
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 1000
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(profileId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'doctorName', 'specialty', 'dateTime', 'location', 'notes'
          ]);
        allow delete: if isMember(profileId);
      }

      match /reminders/{reminderId} {
        allow read: if isMember(profileId);
        allow write: if false;
      }

      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}


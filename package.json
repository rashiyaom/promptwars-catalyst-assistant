{
  "name": "sanjeevani",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "src",
    "shared",
    "web",
    "functions"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @sanjeevani/web",
    "emulators": "firebase emulators:start --project demo-sanjeevani --only auth,firestore,functions,hosting",
    "build": "npm run typecheck && npm run build --workspace @sanjeevani/web && npm run build --workspace @sanjeevani/functions",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build --workspace @sanjeevani/web && firebase deploy --only hosting",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
